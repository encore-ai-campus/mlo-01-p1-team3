# =============================================================================
# [START] Monitoring EC2 resource-log archive configuration example
# Purpose:
#   Copy to /etc/car-market/monitoring-log-archive.env on Monitoring EC2.
#   The ingest process creates and maintains a separate directory per source.
# =============================================================================

STAGING_ROOT=/var/spool/car-market/incoming
ARCHIVE_ROOT=/var/log/car-market/archive
QUARANTINE_ROOT=/var/spool/car-market/quarantine
STATE_DIR=/var/lib/car-market/monitoring-log-archive
STATUS_LOG=/var/log/car-market/archive-ingest-status.jsonl
LOCK_FILE=/run/car-market/monitoring-log-archive.lock

FLOCK_BIN=/usr/bin/flock
GZIP_BIN=/usr/bin/gzip

# Staging is writable by the SSH log-shipping account. Final archives and
# quarantine remain owned by root and are written only by the ingest job.
STAGING_OWNER=logship
STAGING_GROUP=logship
STAGING_ROOT_OWNER=root
STAGING_ROOT_GROUP=logship
ARCHIVE_OWNER=root
ARCHIVE_GROUP=root
ARCHIVE_FILE_MODE=0640

# Set to 0 only in the repository's Windows/Git Bash workflow test.
OWNERSHIP_ENABLED=1

# =============================================================================
# [END] Monitoring EC2 resource-log archive configuration example
# =============================================================================
