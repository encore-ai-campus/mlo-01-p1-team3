# =============================================================================
# [START] Source EC2 resource-log archive configuration example
# Purpose:
#   Copy to /etc/car-market/source-log-archive.env on each of the six source
#   EC2 instances. Change SOURCE_ID and SSH identity values for that host.
# =============================================================================

# Allowed values:
# collector | mysql-primary | mysql-secondary | mongo-01 | mongo-02 | mongo-03
SOURCE_ID=collector

ROTATED_DIR=/var/log/car-market/archive-outbox
ROTATED_GLOB=resource.log-*.gz

LOCK_FILE=/run/car-market/resource-log-archive.lock
STATE_DIR=/var/lib/car-market/resource-log-archive
STATUS_LOG=/var/log/car-market/archive-status.jsonl

LOGROTATE_BIN=/usr/sbin/logrotate
LOGROTATE_CONFIG=/etc/car-market/resource-logrotate.conf
LOGROTATE_STATE=/var/lib/car-market/resource-logrotate.status
FLOCK_BIN=/usr/bin/flock

RSYNC_BIN=/usr/bin/rsync
SSH_BIN=/usr/bin/ssh
RSYNC_TIMEOUT_SECONDS=120
SSH_PORT=22

# Use a different private key for each source EC2 when possible.
SSH_KEY=/etc/car-market/keys/resource-logship_ed25519
KNOWN_HOSTS=/etc/car-market/known_hosts
REMOTE_USER=logship
MONITORING_HOST=10.0.10.40
REMOTE_STAGING_ROOT=/var/spool/car-market/incoming

# =============================================================================
# [END] Source EC2 resource-log archive configuration example
# =============================================================================
