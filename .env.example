APP_ENV=local
APP_NAME=mlo-pipeline
TIMEZONE=Asia/Seoul

USED_CAR_BASE_URL=http://192.168.0.51:4000
USED_CAR_API_KEY=
USED_CAR_BATCH_SIZE=500
USED_CAR_INITIAL_TARGET=10000
USED_CAR_INTERVAL_SECONDS=1
HTTP_TIMEOUT_SECONDS=30
OUTPUT_DIR=output
LOG_PATH=output/data_preprocessing.jsonl

# FAQ source policy. The collector requests /faqs only and keeps the official
# source URL as attribution; it does not crawl the third-party URL.
FAQ_SOURCE_URL=http://192.168.0.51:4000/faqs
FAQ_ALLOWED_PATHS=/faqs
FAQ_MAX_PAGES=100
FAQ_INTERVAL_SECONDS=1
FAQ_LICENSE=educational-sandbox-rewrite
FAQ_ATTRIBUTION=AutoData Lab educational snapshot; official source URL retained
FAQ_STATE_PATH=output/faq_checkpoint.json

# MOLIT registration-report Open API. Never commit the real key.
REGISTRATION_API_URL=https://stat.molit.go.kr/portal/openapi/service/rest/getList.do
REGISTRATION_API_KEY=
REGISTRATION_SOURCE_PAGE=https://stat.molit.go.kr/portal/cate/statView.do?hRsId=58&hFormId=5498
REGISTRATION_FORM_ID=5498
REGISTRATION_STYLE_NUM=2
REGISTRATION_DAILY_QUOTA=3000
REGISTRATION_START_PERIOD=
REGISTRATION_STATE_PATH=output/registration_state.json

# Prefer MONGODB_URI for production. For local standalone MongoDB, the host,
# port, user, and password variables below are composed into the URI.
MONGODB_URI=
MONGODB_HOST=localhost
MONGODB_PORT=27017
MONGODB_USER=
MONGODB_PASSWORD=
MONGODB_AUTH_SOURCE=admin
MONGODB_DATABASE=support_db
MONGODB_FAQ_COLLECTION=faq
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000

# SQL_JDBC_URL supplies host/port/database. SQL_HOST/SQL_PORT/SQL_DATABASE
# override its parts when set. Keep SQL_PASSWORD empty for a password-less
# local account; the application reads an empty password as Python None.
SQL_JDBC_URL=jdbc:mysql://localhost:3306/
SQL_HOST=
SQL_PORT=3306
SQL_DATABASE=sales_support_db
SQL_USER=root
SQL_PASSWORD=
SQL_LOG_DATABASE=application_logs
